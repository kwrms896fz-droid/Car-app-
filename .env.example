# Mode de collecte des réponses IA.
#   mock (défaut) : données factices déterministes, aucune clé requise.
#   live          : appelle les vraies API pour les fournisseurs configurés,
#                   et retombe sur le mock pour les autres.
AI_VISIBILITY_MODE=mock

# Clés à renseigner quand vous passerez en mode live.
# Voir lib/providers/*.ts : chaque fichier contient le point de branchement.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
