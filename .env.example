EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL du build web (expo export -p web) une fois déployé, utilisée pour générer
# les liens publics partageables (ex. https://carnetgarage.app)
EXPO_PUBLIC_WEB_URL=https://carnetgarage.app

# Mode démo (optionnel) : mettre à 1 pour tester l'app avec des données de
# démonstration en mémoire, sans backend Supabase réel (aucune donnée n'est
# sauvegardée). Dans ce mode, les variables Supabase ci-dessus ne sont pas
# nécessaires. Laissez cette ligne absente/vide pour utiliser votre vrai
# projet Supabase — voir README « Tester rapidement sans backend ».
# EXPO_PUBLIC_PREVIEW=1
